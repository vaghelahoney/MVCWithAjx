@{
    ViewData["Title"] = "Bank Master";
}

<div class="text-center">
    <h2 class="display-4">Bank Master</h2>
</div>

<select id="bankDropdown" class="form-control mb-3">
    <option value="">Select Option</option>
    <option value="hide">List Banks</option>
    <option value="show">Add Bank</option>
</select>

<div id="bankFormDiv" style="display:none;">
    <div class="card">
        <div class="card-header bg-primary text-white">Bank Details</div>
        <div class="card-body">
            <form id="bankForm">
                <input type="hidden" id="BankId" value="0" />
                
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label>Bank Name</label>
                        <input type="text" id="BankName" class="form-control" required />
                    </div>
                    <div class="col-md-4 form-group">
                        <label>IFSC Code</label>
                        <input type="text" id="IFSCCode" class="form-control" required />
                    </div>
                    <div class="col-md-2 form-group">
                        <label>Is Active</label>
                        <div class="form-check mt-2">
                            <input type="checkbox" id="BankIsActive" class="form-check-input" checked />
                        </div>
                    </div>
                </div>

                <hr />
                <h4>Bank Branches / Details</h4>
                <button type="button" class="btn btn-sm btn-success mb-2" onclick="addBankDetailRow()">+ Add Branch</button>
                
                <table class="table table-bordered" id="bankDetailsTable">
                    <thead>
                        <tr>
                            <th>Account Name</th>
                            <th>Account Number</th>
                            <th>Branch Name</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="bankDetailsBody">
                    </tbody>
                </table>

                <div class="form-group mt-3">
                    <button type="button" onclick="saveBank()" class="btn btn-primary">Save Bank Data</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="bankListDiv" style="display:none;">
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#bankDropdown').on('change', function () {
                var val = $(this).val();
                if (val === 'show') {
                    clearBankForm();
                    $('#bankFormDiv').show();
                    $('#bankListDiv').hide();
                } else if (val === 'hide') {
                    $('#bankFormDiv').hide();
                    $('#bankListDiv').show();
                    loadBankList();
                } else {
                    $('#bankFormDiv').hide();
                    $('#bankListDiv').hide();
                }
            });
        });

        function loadBankList() {
            $.ajax({
                type: "GET",
                url: "/Bank/GetBankList",
                success: function (res) {
                    $('#bankListDiv').html(res);
                }
            });
        }

        function clearBankForm() {
            $('#BankId').val("0");
            $('#BankName').val("");
            $('#IFSCCode').val("");
            $('#BankIsActive').prop('checked', true);
            $('#bankDetailsBody').empty();
            addBankDetailRow(); // add one empty row by default
        }

        function addBankDetailRow(id = 0, accName = '', accNo = '', branch = '') {
            var rowIdx = $('#bankDetailsBody tr').length;
            var tr = `<tr id="tr_${rowIdx}">
                        <td>
                            <input type="hidden" class="bd-id" value="${id}" />
                            <input type="text" class="form-control bd-accname" value="${accName}" required />
                        </td>
                        <td><input type="text" class="form-control bd-accno" value="${accNo}" required /></td>
                        <td><input type="text" class="form-control bd-branch" value="${branch}" required /></td>
                        <td><button type="button" class="btn btn-sm btn-danger" onclick="removeBankDetailRow(${rowIdx})">X</button></td>
                      </tr>`;
            $('#bankDetailsBody').append(tr);
        }

        function removeBankDetailRow(index) {
            $('#tr_' + index).remove();
        }

        function saveBank() {
            var bankId = $('#BankId').val();
            var name = $('#BankName').val();
            var ifsc = $('#IFSCCode').val();
            var isActive = $('#BankIsActive').is(':checked');

            if (!name || !ifsc) {
                alert("Bank Name and IFSC Code are required.");
                return;
            }

            var bankDetails = [];
            var detailsValid = true;

            $('#bankDetailsBody tr').each(function () {
                var dId = $(this).find('.bd-id').val();
                var dAccName = $(this).find('.bd-accname').val();
                var dAccNo = $(this).find('.bd-accno').val();
                var dBranch = $(this).find('.bd-branch').val();

                if (!dAccName || !dAccNo || !dBranch) {
                    detailsValid = false;
                }

                bankDetails.push({
                    Id: parseInt(dId) || 0,
                    AccountName: dAccName,
                    AccountNumber: dAccNo,
                    BranchName: dBranch
                });
            });

            if (!detailsValid) {
                alert("Please fill all bank details fields properly.");
                return;
            }

            var payload = {
                Id: parseInt(bankId) || 0,
                Name: name,
                IFSCCode: ifsc,
                IsActive: isActive,
                BankDetails: bankDetails
            };

            $.ajax({
                type: "POST",
                url: "/Bank/Save",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        alert(res.message);
                        $('#bankDropdown').val('hide').trigger('change');
                    } else {
                        alert("Error: " + res.message);
                    }
                },
                error: function () {
                    alert("Error calling API");
                }
            });
        }

        function editBank(id) {
            $.ajax({
                type: "GET",
                url: "/Bank/GetById/" + id,
                success: function (bank) {
                    $('#BankId').val(bank.id);
                    $('#BankName').val(bank.name);
                    $('#IFSCCode').val(bank.ifscCode);
                    $('#BankIsActive').prop('checked', bank.isActive);

                    $('#bankDetailsBody').empty();
                    if (bank.bankDetails && bank.bankDetails.length > 0) {
                        $.each(bank.bankDetails, function (i, detail) {
                            addBankDetailRow(detail.id, detail.accountName, detail.accountNumber, detail.branchName);
                        });
                    } else {
                        addBankDetailRow();
                    }

                    $('#bankDropdown').val('show');
                    $('#bankFormDiv').show();
                    $('#bankListDiv').hide();
                }
            });
        }

        function deleteBank(id) {
            if (confirm("Are you sure you want to delete this Bank? All related branches will be deleted too.")) {
                $.ajax({
                    type: "DELETE",
                    url: "/Bank/Delete/" + id,
                    success: function (res) {
                        if(res.success) {
                            alert(res.message);
                            loadBankList();
                        }
                    }
                });
            }
        }
    </script>
}
