@model IEnumerable<Student>

<table class="table">
    <thead>
        <tr>
            <th>FirstName</th>
            <th>LastName</th>
            <th>Email</th>
            <th>Mobile</th>
            <th>Address</th>
            <th>Aadhar Number</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.Email</td>
                <td>@(item.StudentDetails?.MobileNumber ?? "N/A")</td>
                <td>@(item.StudentDetails?.Address ?? "N/A")</td>
                <td>@(item.StudentDetails?.AadharNumber ?? "N/A")</td>
                <td>
                    <button type="button" class="btn btn-sm btn-info" onclick="alert('Address: ' + '@(item.StudentDetails?.Address ?? "")' + '\nAadhar: ' + '@(item.StudentDetails?.AadharNumber ?? "")')">
                        Details
                    </button>
                    <button type="button" class="btn btn-sm btn-warning" onclick="editStudent(@item.Id)">
                        Edit
                    </button>
                    
                    <button type="button" class="btn btn-sm btn-danger" onclick="deleteStudent(@item.Id)">
                        Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
